<div class="max-w-xl mx-auto mt-12 bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50">
    <h3 class="text-lg font-bold text-gray-800">Create New Classroom</h3>
    <%= link_to root_path, class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
      <i class="ri-close-line text-2xl"></i>
    <% end %>
  </div>

  <%= form_with(model: @classroom, local: true, class: "p-8") do |form| %>
    <div class="mb-8">
      <%= form.label :name, "Classroom Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :name, required: true, placeholder: "12 STEM-T2", class: "w-full rounded-lg border border-gray-300 px-5 py-4 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" %>
    </div>

    <div class="flex justify-end gap-3 pt-6 border-t border-gray-100">
      <%= link_to "Cancel", root_path, class: "px-6 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" %>
      
      <%= form.submit "Create Classroom", class: "cursor-pointer bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white text-sm font-medium py-2.5 px-6 rounded-lg border border-blue-200 shadow-sm transition-all duration-200" %>
    </div>
  <% end %>
</div>
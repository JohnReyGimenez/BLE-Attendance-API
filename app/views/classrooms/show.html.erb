<div class="flex items-center justify-between mb-8">
  <div class="flex items-center gap-4">
    <%= link_to root_path, class: "w-10 h-10 rounded-full bg-white border border-gray-200 flex items-center justify-center text-gray-500 hover:text-blue-600 hover:border-blue-200 transition-colors shadow-sm" do %>
      <i class="ri-arrow-left-line"></i>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-gray-800"><%= @classroom.name %></h1>
      <p class="text-gray-500 text-sm">Attendance List</p>
    </div>
  </div>

  <div class="flex items-center gap-4">
    <form action="<%= classroom_path(@classroom) %>" method="get" class="flex items-center gap-2 bg-white px-3 py-2 rounded-lg border border-gray-200 shadow-sm">
      <input type="date" name="date" value="<%= @date %>" 
             class="border-none text-sm text-gray-600 focus:ring-0 rounded-md bg-transparent outline-none cursor-pointer" 
             onchange="this.form.submit()">
    </form>

    <%= button_to archive_classroom_path(@classroom), method: :patch, form_class: "inline-block", class: "cursor-pointer flex items-center gap-2 bg-white text-gray-600 hover:bg-gray-50 hover:text-gray-900 text-sm font-medium py-2.5 px-5 rounded-lg border border-gray-200 shadow-sm transition-all duration-200" do %>
      <i class="ri-archive-line text-lg"></i>
      <span><%= @classroom.archived ? 'Unarchive' : 'Archive' %></span>
    <% end %>

    <button onclick="document.getElementById('assign-modal').classList.remove('hidden')" 
            class="cursor-pointer flex items-center gap-2 bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white text-sm font-medium py-2.5 px-6 rounded-lg border border-blue-200 shadow-sm transition-all duration-200">
      <i class="ri-user-add-line text-lg"></i> 
      <span>Assign Student</span>
    </button>
  </div>
</div>

<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden mb-8">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-200 text-xs uppercase text-gray-500 font-semibold tracking-wider">
          <th class="px-6 py-4">Student Name</th>
          <th class="px-6 py-4">ID Number</th>
          <th class="px-6 py-4">Entered At</th>
          <th class="px-6 py-4">Exited At</th>
          <th class="px-6 py-4 text-center">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @students.each do |student| %>
          <% records = @attendance_data[student.id] %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= student.name %></div>
            </td>
            <td class="px-6 py-4 text-gray-500 text-sm font-mono">
              <%= student.student_id_number %>
            </td>
            <td class="px-6 py-4 text-gray-600 text-sm">
              <div class="flex items-center gap-2">
                <i class="ri-login-circle-line text-green-500"></i>
                <%= get_event_time(records, 'entered') rescue 'N/A' %>
              </div>
            </td>
            <td class="px-6 py-4 text-gray-600 text-sm">
              <div class="flex items-center gap-2">
                <i class="ri-logout-circle-line text-red-500"></i>
                <%= get_event_time(records, 'exited') rescue 'N/A' %>
              </div>
            </td>
            <td class="px-6 py-4 text-center">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= records.present? ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                <%= records.present? ? 'Present' : 'Absent' %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <% if @students.empty? %>
    <div class="p-16 text-center text-gray-400">
      <i class="ri-ghost-line text-5xl mb-3"></i>
      <p class="text-base">No students assigned to this classroom yet.</p>
    </div>
  <% end %>
</div>

<div id="assign-modal" class="hidden fixed inset-0 overflow-y-auto" style="z-index: 9999;" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="fixed inset-0 bg-gray-900 bg-opacity-50 transition-opacity backdrop-blur-sm"></div>

  <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
    <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-md z-10">
      
      <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
        <h3 class="font-bold text-gray-800">Add Student to <%= @classroom.name %></h3>
        <button type="button" onclick="document.getElementById('assign-modal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 transition-colors cursor-pointer">
          <i class="ri-close-line text-xl"></i>
        </button>
      </div>
      
      <form action="<%= assign_student_classroom_path(@classroom) %>" method="post" class="p-6">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
          <input type="text" name="name" required placeholder="Juan Dela Cruz" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
        </div>

        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Student ID Number</label>
          <input type="text" name="student_id_number" required placeholder="e.g., 19020153" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
        </div>

        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">BLE Tag MAC Address</label>
          <input type="text" name="mac_address" required placeholder="AA:BB:CC:DD:EE:FF" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all font-mono uppercase">
          <p class="text-xs text-gray-500 mt-2">Scan the physical tag with the nRF Connect app to get this MAC address.</p>
        </div>

        <div class="flex justify-end gap-3 mt-6">
          <button type="button" onclick="document.getElementById('assign-modal').classList.add('hidden')" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors cursor-pointer">Cancel</button>
          <button type="submit" class="cursor-pointer bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white text-sm font-medium py-2 px-4 rounded-lg border border-blue-200 shadow-sm transition-all duration-200">Save & Assign</button>
        </div>
      </form>
    </div>
  </div>
</div>
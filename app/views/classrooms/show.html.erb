<div class="flex items-center justify-between mb-6">
  <div class="flex items-center gap-4">
    <%= link_to classrooms_path, class: "w-10 h-10 rounded-full bg-white border border-gray-200 flex items-center justify-center text-gray-500 hover:text-blue-600 hover:border-blue-200 transition-colors" do %>
      <i class="ri-arrow-left-line"></i>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-gray-800"><%= @classroom.name %></h1>
      <p class="text-gray-500 text-sm">Attendance List</p>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <form action="<%= classroom_path(@classroom) %>" method="get" class="flex items-center gap-2 bg-white p-1 rounded-lg border border-gray-200 shadow-sm">
      <input type="date" name="date" value="<%= @date %>" 
             class="border-none text-sm text-gray-600 focus:ring-0 rounded-md bg-transparent" 
             onchange="this.form.submit()">
    </form>

    <button onclick="document.getElementById('assign-modal').classList.remove('hidden')" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-blue-700 transition shadow-sm">
      <i class="ri-user-add-line mr-1"></i> Assign Student
    </button>
  </div>
</div>

<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-200 text-xs uppercase text-gray-500 font-semibold tracking-wider">
          <th class="px-6 py-4">Student Name</th>
          <th class="px-6 py-4">ID Number</th>
          <th class="px-6 py-4">Entered At</th>
          <th class="px-6 py-4">Exited At</th>
          <th class="px-6 py-4 text-center">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @students.each do |student| %>
          <% records = @attendance_data[student.id] %>
          
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= student.name %></div>
            </td>
            <td class="px-6 py-4 text-gray-500 text-sm font-mono">
              <%= student.student_id_number %>
            </td>
            
            <td class="px-6 py-4 text-gray-600 text-sm">
              <div class="flex items-center gap-2">
                <i class="ri-login-circle-line text-green-500"></i>
                <%= get_event_time(records, 'entered') %>
              </div>
            </td>

            <td class="px-6 py-4 text-gray-600 text-sm">
              <div class="flex items-center gap-2">
                <i class="ri-logout-circle-line text-red-500"></i>
                <%= get_event_time(records, 'exited') %>
              </div>
            </td>

            <td class="px-6 py-4 text-center">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_badge(records) %>">
                <%= records.present? ? 'Present' : 'Absent' %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <% if @students.empty? %>
    <div class="p-12 text-center text-gray-400">
      <i class="ri-ghost-line text-4xl mb-2"></i>
      <p>No students assigned to this classroom yet.</p>
    </div>
  <% end %>
</div>

<div id="assign-modal" class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center backdrop-blur-sm">
  <div class="bg-white rounded-xl shadow-xl w-full max-w-md overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
      <h3 class="font-bold text-gray-800">Assign Student to <%= @classroom.name %></h3>
      <button onclick="document.getElementById('assign-modal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600">
        <i class="ri-close-line text-xl"></i>
      </button>
    </div>
    
    <form action="<%= assign_student_classroom_path(@classroom) rescue '#' %>" method="post" class="p-6">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">Student ID or Email</label>
        <input type="text" name="identifier" placeholder="e.g., 2024-0001 or student@school.edu" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
        <p class="text-xs text-gray-500 mt-2">Enter the student's registered ID number or email to link them to this class.</p>
      </div>

      <div class="flex justify-end gap-3 mt-6">
        <button type="button" onclick="document.getElementById('assign-modal').classList.add('hidden')" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg transition-colors text-sm font-medium">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors text-sm font-medium">Assign Student</button>
      </div>
    </form>
  </div>
</div>
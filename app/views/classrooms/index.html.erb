<div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
  <div>
    <h1 class="text-3xl font-bold text-gray-900">Dashboard</h1>
    <p class="text-gray-500 mt-1">Overview of your classrooms and attendance.</p>
  </div>
  
  <%= link_to new_classroom_path, class: "flex items-center gap-2 bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white text-sm font-medium py-2.5 px-6 rounded-lg border border-blue-200 shadow-sm transition-all duration-200" do %>
    <i class="ri-add-line text-lg"></i>
    <span>Create Classroom</span>
  <% end %>
</div>

<div class="flex border-b border-gray-200 mb-8">
  <%= link_to root_path, class: "px-6 py-3 border-b-2 font-medium text-sm transition-all #{ @current_filter == 'active' ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }" do %>
    Active Classrooms
    <span class="ml-2 py-0.5 px-2.5 rounded-full text-xs <%= @current_filter == 'active' ? 'bg-blue-100 text-blue-600' : 'bg-gray-100 text-gray-600' %>">
      <%= Classroom.where(archived: false).count %>
    </span>
  <% end %>

  <%= link_to root_path(filter: 'archived'), class: "px-6 py-3 border-b-2 font-medium text-sm transition-all #{ @current_filter == 'archived' ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }" do %>
    Archived
    <span class="ml-2 py-0.5 px-2.5 rounded-full text-xs <%= @current_filter == 'archived' ? 'bg-blue-100 text-blue-600' : 'bg-gray-100 text-gray-600' %>">
      <%= Classroom.where(archived: true).count %>
    </span>
  <% end %>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
  <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex items-center gap-4">
    <div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 text-xl">
      <i class="ri-user-line"></i>
    </div>
    <div>
      <div class="text-2xl font-bold text-gray-800"><%= Student.count %></div>
      <div class="text-sm text-gray-500">Total Students</div>
    </div>
  </div>
  
  <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex items-center gap-4">
     <div class="w-12 h-12 rounded-full bg-green-50 flex items-center justify-center text-green-600 text-xl">
      <i class="ri-check-double-line"></i>
    </div>
    <div>
      <div class="text-2xl font-bold text-gray-800"><%= AttendanceRecord.where(timestamp: Date.today.all_day).select(:student_id).distinct.count %></div>
      <div class="text-sm text-gray-500">Present Today</div>
    </div>
  </div>

  <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex items-center gap-4">
    <div class="w-12 h-12 rounded-full bg-purple-50 flex items-center justify-center text-purple-600 text-xl">
      <i class="ri-building-line"></i>
    </div>
    <div>
      <div class="text-2xl font-bold text-gray-800"><%= @classrooms.count %></div>
      <div class="text-sm text-gray-500">
        <%= @current_filter == 'archived' ? 'Archived Classrooms' : 'Active Classrooms' %>
      </div>
    </div>
  </div>
</div>

<h2 class="text-lg font-bold text-gray-800 mb-4">Your Classrooms</h2>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% @classrooms.each do |classroom| %>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow duration-200 overflow-hidden group">
      <div class="p-6">
        <div class="flex justify-between items-start mb-4">
          <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center">
             <i class="ri-book-open-line text-lg"></i>
          </div>
          <span class="text-xs font-semibold px-2 py-1 rounded <%= classroom.archived ? 'bg-gray-100 text-gray-600' : 'bg-green-100 text-green-700' %>">
            <%= classroom.archived ? 'Archived' : 'Active' %>
          </span>
        </div>
        
        <h3 class="text-xl font-bold text-gray-800 mb-1"><%= classroom.name %></h3>
        <p class="text-sm text-gray-500 mb-4"><%= classroom.students.count %> Students enrolled</p>
      </div>
      
      <div class="bg-gray-50 px-6 py-3 border-t border-gray-100 flex justify-between items-center group-hover:bg-blue-50 transition-colors">
        <span class="text-sm font-medium text-gray-600 group-hover:text-blue-700">View Details</span>
        <%= link_to classroom_path(classroom), class: "w-8 h-8 rounded-full bg-white flex items-center justify-center text-gray-400 group-hover:text-blue-600 shadow-sm" do %>
          <i class="ri-arrow-right-line"></i>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @classrooms.empty? %>
    <div class="col-span-full p-12 text-center text-gray-400 border-2 border-dashed border-gray-200 rounded-xl">
      <i class="ri-ghost-line text-4xl mb-2"></i>
      <p>No classrooms found here.</p>
    </div>
  <% end %>
</div>
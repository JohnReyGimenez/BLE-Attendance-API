<div class="w-full max-w-md mx-auto mt-16 bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
  
  <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-center bg-gray-50">
    <h3 class="text-xl font-bold text-gray-800">Sign up for an account</h3>
  </div>

  <%= form_with model: @user, url: signup_path, class: "p-8" do |form| %>
    <% if @user.errors.any? %>
      <div class="mb-6 p-4 rounded-lg bg-red-50 text-red-600 text-sm font-medium border border-red-200">
        <%= @user.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="mb-6">
      <%= form.label :email_address, "Email Address", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.email_field :email_address, required: true, autofocus: true, placeholder: "john@example.com", class: "w-full rounded-lg border border-gray-300 px-5 py-3.5 text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" %>
    </div>

    <div class="mb-6">
      <%= form.label :password, "Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.password_field :password, required: true, placeholder: "••••••••", class: "w-full rounded-lg border border-gray-300 px-5 py-3.5 text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" %>
    </div>

    <div class="mb-8">
      <%= form.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.password_field :password_confirmation, required: true, placeholder: "••••••••", class: "w-full rounded-lg border border-gray-300 px-5 py-3.5 text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" %>
    </div>

    <div class="flex flex-col gap-4 pt-6 border-t border-gray-100">
      <%= form.submit "Sign Up", class: "w-full cursor-pointer bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white text-base font-bold py-3.5 px-6 rounded-lg border border-blue-200 shadow-sm transition-all duration-200" %>
      
      <p class="text-center text-sm text-gray-600 mt-2">
        Already a member? 
        <%= link_to "Log in now", new_session_path, class: "font-semibold text-blue-600 hover:text-blue-800 transition-colors" %>
      </p>
    </div>
    
  <% end %>
</div>
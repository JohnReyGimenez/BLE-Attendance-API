<div class="flex items-center justify-between mb-6">
  <div class="flex items-center gap-4">
    <%= link_to groups_path, class: "w-10 h-10 rounded-full bg-white border border-gray-200 flex items-center justify-center text-gray-500 hover:text-blue-600 hover:border-blue-200 transition-colors" do %>
      <i class="ri-arrow-left-line"></i>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-gray-800"><%= @block_name %></h1>
      <p class="text-gray-500 text-sm">Attendance List</p>
    </div>
  </div>

  <form action="<%= group_path(@block_name) %>" method="get" class="flex items-center gap-2 bg-white p-1 rounded-lg border border-gray-200 shadow-sm">
    <input type="date" name="date" value="<%= @date %>" 
           class="border-none text-sm text-gray-600 focus:ring-0 rounded-md bg-transparent" 
           onchange="this.form.submit()">
  </form>
</div>

<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-200 text-xs uppercase text-gray-500 font-semibold tracking-wider">
          <th class="px-6 py-4">Student Name</th>
          <th class="px-6 py-4">ID Number</th>
          <th class="px-6 py-4">Entered At</th>
          <th class="px-6 py-4">Exited At</th>
          <th class="px-6 py-4 text-center">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @students.each do |student| %>
          <% # Get records for this specific student from our pre-fetched list %>
          <% records = @attendance_data[student.id] %>
          
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= student.name %></div>
            </td>
            <td class="px-6 py-4 text-gray-500 text-sm font-mono">
              <%= student.student_id_number %>
            </td>
            
            <td class="px-6 py-4 text-gray-600 text-sm">
              <div class="flex items-center gap-2">
                <i class="ri-login-circle-line text-green-500"></i>
                <%= get_event_time(records, 'entered') %>
              </div>
            </td>

            <td class="px-6 py-4 text-gray-600 text-sm">
              <div class="flex items-center gap-2">
                <i class="ri-logout-circle-line text-red-500"></i>
                <%= get_event_time(records, 'exited') %>
              </div>
            </td>

            <td class="px-6 py-4 text-center">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_badge(records) %>">
                <%= records.present? ? 'Present' : 'Absent' %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <% if @students.empty? %>
    <div class="p-12 text-center text-gray-400">
      <i class="ri-ghost-line text-4xl mb-2"></i>
      <p>No students found in this block.</p>
    </div>
  <% end %>
</div>